
#include <iostream>
using namespace std;

struct Edge {
    int u, v, w;
};

int main() {
    int n, m, source;
    Edge e[200];

    cout << "Enter vertices and edges: ";
    cin >> n >> m;

    cout << "Enter edges (u v weight):\n";
    for (int i = 0; i < m; i++) {
        cin >> e[i].u >> e[i].v >> e[i].w;
    }

    cout << "Enter source vertex: ";
    cin >> source;

    int dist[100];

    for (int i = 0; i < n; i++)
        dist[i] = 999999;

    dist[source] = 0;

    for (int i = 1; i <= n - 1; i++) {
        for (int j = 0; j < m; j++) {
            int u = e[j].u;
            int v = e[j].v;
            int w = e[j].w;

            if (dist[u] != 999999 &&
                dist[u] + w < dist[v]) {
                dist[v] = dist[u] + w;
            }
        }
    }

    for (int j = 0; j < m; j++) {
        int u = e[j].u;
        int v = e[j].v;
        int w = e[j].w;

        if (dist[u] != 999999 &&
            dist[u] + w < dist[v]) {
            cout << "Negative weight cycle exists";
            return 0;
        }
    }

    cout << "Shortest distances:\n";

    for (int i = 0; i < n; i++) {
        cout << source << " to " << i << " = ";

        if (dist[i] == 999999)
            cout << "INF";
        else
            cout << dist[i];

        cout << endl;
    }

    return 0;
}

SAMPLE INPUT : 
5 8
0 1 4
0 2 2
1 2 -2
1 3 3
2 3 2
2 4 5
3 4 1
4 1 1
0

OUTPUT: 
Shortest distances:
0 to 0 = 0
0 to 1 = 4
0 to 2 = 2
0 to 3 = 4
0 to 4 = 5
