
#include <iostream>
using namespace std;

class BTreeNode {
public:
    int keys[3];
    BTreeNode* child[4];
    int n;
    bool leaf;

    BTreeNode(bool l) {
        n = 0;
        leaf = l;

        for (int i = 0; i < 4; i++)
            child[i] = NULL;
    }

    void traverse() {
        int i;

        for (i = 0; i < n; i++) {
            if (!leaf)
                child[i]->traverse();

            cout << keys[i] << " ";
        }

        if (!leaf)
            child[i]->traverse();
    }

    bool search(int k) {
        int i = 0;

        while (i < n && k > keys[i])
            i++;

        if (i < n && keys[i] == k)
            return true;

        if (leaf)
            return false;

        return child[i]->search(k);
    }

    void insertNonFull(int k);
    void splitChild(int i, BTreeNode* y);
};

class BTree {
public:
    BTreeNode* root;

    BTree() {
        root = NULL;
    }

    void insert(int k) {
        if (root == NULL) {
            root = new BTreeNode(true);
            root->keys[0] = k;
            root->n = 1;
            return;
        }

        if (root->n == 3) {
            BTreeNode* s = new BTreeNode(false);

            s->child[0] = root;
            s->splitChild(0, root);

            int i = 0;
            if (s->keys[0] < k)
                i++;

            s->child[i]->insertNonFull(k);
            root = s;
        }
        else {
            root->insertNonFull(k);
        }
    }

    void traverse() {
        if (root != NULL)
            root->traverse();
    }

    bool search(int k) {
        return root != NULL && root->search(k);
    }
};

void BTreeNode::splitChild(int i, BTreeNode* y) {
    BTreeNode* z = new BTreeNode(y->leaf);
    z->n = 1;

    z->keys[0] = y->keys[2];

    if (!y->leaf) {
        z->child[0] = y->child[2];
        z->child[1] = y->child[3];
    }

    y->n = 1;

    for (int j = n; j >= i + 1; j--)
        child[j + 1] = child[j];

    child[i + 1] = z;

    for (int j = n - 1; j >= i; j--)
        keys[j + 1] = keys[j];

    keys[i] = y->keys[1];
    n++;
}

void BTreeNode::insertNonFull(int k) {
    int i = n - 1;

    if (leaf) {
        while (i >= 0 && keys[i] > k) {
            keys[i + 1] = keys[i];
            i--;
        }

        keys[i + 1] = k;
        n++;
    }
    else {
        while (i >= 0 && keys[i] > k)
            i--;

        i++;

        if (child[i]->n == 3) {
            splitChild(i, child[i]);

            if (keys[i] < k)
                i++;
        }

        child[i]->insertNonFull(k);
    }
}

int main() {
    BTree tree;
    int n, x;

    cout << "Enter number of elements: ";
    cin >> n;

    cout << "Enter elements:\n";

    for (int i = 0; i < n; i++) {
        cin >> x;
        tree.insert(x);
    }

    cout << "B-Tree traversal: ";
    tree.traverse();

    cout << "\nEnter element to search: ";
    cin >> x;

    if (tree.search(x))
        cout << "Element found";
    else
        cout << "Element not found";

    return 0;
}


