
#include <iostream>
#include <string>
using namespace std;

void computeLPS(string p, int lps[]) {
    int len = 0;
    int i = 1;

    lps[0] = 0;

    while (i < p.length()) {
        if (p[i] == p[len]) {
            len++;
            lps[i] = len;
            i++;
        }
        else {
            if (len != 0)
                len = lps[len - 1];
            else {
                lps[i] = 0;
                i++;
            }
        }
    }
}

void KMP(string text, string pattern) {
    int n = text.length();
    int m = pattern.length();

    if (m == 0) {
        cout << "Empty pattern";
        return;
    }

    int lps[1000];

    computeLPS(pattern, lps);

    int i = 0, j = 0;
    bool found = false;

    while (i < n) {
        if (text[i] == pattern[j]) {
            i++;
            j++;
        }

        if (j == m) {
            cout << "Pattern found at index "
                 << i - j << endl;

            found = true;
            j = lps[j - 1];
        }
        else if (i < n && text[i] != pattern[j]) {
            if (j != 0)
                j = lps[j - 1];
            else
                i++;
        }
    }

    if (!found)
        cout << "Pattern not found";
}

int main() {
    string text, pattern;

    cout << "Enter text: ";
    cin >> text;

    cout << "Enter pattern: ";
    cin >> pattern;

    KMP(text, pattern);

    return 0;
}


