
#include <iostream>
#include <algorithm>
using namespace std;

struct Edge {
    int u, v, w;
};

int parent[100];

int find(int x) {
    if (parent[x] == x)
        return x;

    return parent[x] = find(parent[x]);
}

void unite(int a, int b) {
    parent[find(a)] = find(b);
}

int main() {
    int n, m;
    Edge e[200];

    cout << "Enter vertices and edges: ";
    cin >> n >> m;

    cout << "Enter edges (u v weight):\n";
    for (int i = 0; i < m; i++) {
        cin >> e[i].u >> e[i].v >> e[i].w;
    }

    sort(e, e + m, [](Edge a, Edge b) {
        return a.w < b.w;
    });

    for (int i = 0; i < n; i++)
        parent[i] = i;

    int cost = 0, count = 0;

    cout << "Edges in MST:\n";

    for (int i = 0; i < m; i++) {
        int u = e[i].u;
        int v = e[i].v;

        if (find(u) != find(v)) {
            cout << u << " - " << v
                 << " : " << e[i].w << endl;

            unite(u, v);
            cost += e[i].w;
            count++;
        }

        if (count == n - 1)
            break;
    }

    if (count != n - 1)
        cout << "MST does not exist";

    else
        cout << "Total MST cost: " << cost;

    return 0;
}

SAMPLE INPUT :
4 5
0 1 10
0 2 6
0 3 5
1 3 15
2 3 4

SAMPLE OUTPUT : 
Edges in MST:
2 - 3 : 4
0 - 3 : 5
0 - 1 : 10
Total MST cost: 19
