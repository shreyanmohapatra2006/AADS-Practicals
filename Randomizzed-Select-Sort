
#include <iostream>
#include <cstdlib>
#include <ctime>
using namespace std;

int partition(int a[], int low, int high) {
    int r = low + rand() % (high - low + 1);
    swap(a[r], a[high]);

    int pivot = a[high];
    int i = low - 1;

    for (int j = low; j < high; j++) {
        if (a[j] <= pivot) {
            i++;
            swap(a[i], a[j]);
        }
    }

    swap(a[i + 1], a[high]);
    return i + 1;
}

int randomizedSelect(int a[], int low, int high, int k) {
    if (low == high)
        return a[low];

    int p = partition(a, low, high);
    int rank = p - low + 1;

    if (k == rank)
        return a[p];

    else if (k < rank)
        return randomizedSelect(a, low, p - 1, k);

    else
        return randomizedSelect(a, p + 1, high, k - rank);
}

int main() {
    srand(time(0));

    int n, k, a[100];

    cout << "Enter number of elements: ";
    cin >> n;

    cout << "Enter elements: ";
    for (int i = 0; i < n; i++)
        cin >> a[i];

    cout << "Enter value of k: ";
    cin >> k;

    if (k < 1 || k > n) {
        cout << "Invalid k";
        return 0;
    }

    cout << k << "th smallest element: "
         << randomizedSelect(a, 0, n - 1, k);

    return 0;
}
