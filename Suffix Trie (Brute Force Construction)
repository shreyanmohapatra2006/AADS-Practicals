
#include <iostream>
#include <string>
using namespace std;

struct Node {
    Node* child[26];
    bool end;

    Node() {
        end = false;

        for (int i = 0; i < 26; i++)
            child[i] = NULL;
    }
};

class SuffixTrie {
    Node* root;

public:
    SuffixTrie() {
        root = new Node();
    }

    void insert(string s) {
        Node* current = root;

        for (int i = 0; i < s.length(); i++) {
            int index = s[i] - 'A';

            if (current->child[index] == NULL)
                current->child[index] = new Node();

            current = current->child[index];
        }

        current->end = true;
    }

    void build(string s) {
        for (int i = 0; i < s.length(); i++) {
            insert(s.substr(i));
        }
    }

    bool search(string pattern) {
        Node* current = root;

        for (int i = 0; i < pattern.length(); i++) {
            int index = pattern[i] - 'A';

            if (index < 0 || index >= 26)
                return false;

            if (current->child[index] == NULL)
                return false;

            current = current->child[index];
        }

        return true;
    }
};

int main() {
    string text, pattern;

    cout << "Enter string: ";
    cin >> text;

    cout << "Enter pattern: ";
    cin >> pattern;

    SuffixTrie st;

    st.build(text);

    if (st.search(pattern))
        cout << "Pattern found";
    else
        cout << "Pattern not found";

    return 0;
}

